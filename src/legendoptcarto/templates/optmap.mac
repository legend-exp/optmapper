# remage macro for optical map production, generated by legend-optcarto
# production: ${name}

/RMG/Processes/OpticalPhysics true
/RMG/Processes/OpticalPhysicsMaxOneWLSPhoton true

/RMG/Geometry/RegisterDetectorsFromGDML Optical

/RMG/Manager/PrintProgressModulo 100000
/RMG/Geometry/GDMLDisableOverlapCheck true

${pre_init_commands}

/run/initialize

/RMG/Output/NtuplePerDetector false
/RMG/Output/Vertex/StorePrimaryParticleInformation false
/RMG/Output/Vertex/StoreSinglePrecisionEnergy
/RMG/Output/Vertex/StoreSinglePrecisionPosition

${confinement_commands}

/RMG/Generator/Select GPS
/gps/particle     opticalphoton
${energy_commands}
/gps/ang/type     iso

${commands}

/run/beamOn ${n_events}
